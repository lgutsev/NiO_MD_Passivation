pair_coeff 20 20 lj/cut/coul/long 0.210 2.960
pair_coeff 21 21 lj/cut/coul/long 0.211 3.066
pair_coeff 22 22 lj/cut/coul/long 0.211 3.066
pair_coeff 39 39 lj/cut/coul/long 0.046 0.400
